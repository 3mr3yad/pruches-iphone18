# Moyasar publishable key (pk_test_… for testing, pk_live_… in production).
# In Cloudflare: Workers & Pages → pruches-iphone18 → Settings → Build → Variables.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Payment methods shown in the Moyasar form, comma-separated: creditcard, stcpay, applepay
NEXT_PUBLIC_MOYASAR_METHODS=creditcard
